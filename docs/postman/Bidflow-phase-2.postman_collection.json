{
  "info": {
    "name": "Bidflow — Fase 2",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Configurar email/password con un usuario existente y membresía. Ejecutar Flujo completo. Si hay varias organizaciones, seleccionar organization_id luego de /auth/me. Los ejemplos de edición se ejecutan antes de publicación. No guardar tokens ni contraseñas reales en el repositorio."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080/api/v1"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "organization_id",
      "value": ""
    },
    {
      "key": "tender_id",
      "value": ""
    },
    {
      "key": "item_id",
      "value": ""
    },
    {
      "key": "supplier_id",
      "value": ""
    },
    {
      "key": "deadline_at",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Flujo completo",
      "item": [
        {
          "name": "01 Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"device_name\": \"Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "if (body.access_token) pm.collectionVariables.set('token', body.access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Usuario y organizaciones",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data && body.data.organizations.length === 1) pm.collectionVariables.set('organization_id', body.data.organizations[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "03 Crear RFQ",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Organization-ID",
                "value": "{{organization_id}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/tenders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Compra de insumos de oficina\",\n  \"type\": \"products\",\n  \"currency\": \"ARS\",\n  \"deadline_at\": \"{{deadline_at}}\",\n  \"conditions\": {\n    \"delivery\": \"En oficina\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('deadline_at', new Date(Date.now() + 7 * 86400000).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('RFQ creada', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set('tender_id', pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "04 Agregar ítem",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Organization-ID",
                "value": "{{organization_id}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/tenders/{{tender_id}}/items",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Papel reciclado\",\n  \"unit\": \"kg\",\n  \"quantity\": \"1.250\",\n  \"attributes\": {\n    \"color\": \"blanco\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Item creado', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set('item_id', pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "05 Listar proveedores",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Organization-ID",
                "value": "{{organization_id}}"
              }
            ],
            "url": "{{base_url}}/suppliers?per_page=20"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data && body.data.length) pm.collectionVariables.set('supplier_id', body.data[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "06 Invitar proveedor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Organization-ID",
                "value": "{{organization_id}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/tenders/{{tender_id}}/invitations",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"invitations\": [\n    {\n      \"supplier_id\": \"{{supplier_id}}\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Invitación OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "07 Publicar RFQ",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Organization-ID",
                "value": "{{organization_id}}"
              }
            ],
            "url": "{{base_url}}/tenders/{{tender_id}}/publish"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('RFQ publicada', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().data.status).to.eql('published'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "08 Consultar RFQ",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Organization-ID",
                "value": "{{organization_id}}"
              }
            ],
            "url": "{{base_url}}/tenders/{{tender_id}}"
          }
        },
        {
          "name": "09 Listar RFQ",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Organization-ID",
                "value": "{{organization_id}}"
              }
            ],
            "url": "{{base_url}}/tenders?status=published&per_page=20"
          }
        },
        {
          "name": "10 Consultar ítems",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Organization-ID",
                "value": "{{organization_id}}"
              }
            ],
            "url": "{{base_url}}/tenders/{{tender_id}}/items"
          }
        },
        {
          "name": "11 Consultar invitaciones",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Organization-ID",
                "value": "{{organization_id}}"
              }
            ],
            "url": "{{base_url}}/tenders/{{tender_id}}/invitations"
          }
        },
        {
          "name": "12 Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/logout"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Token revocado', () => pm.response.to.have.status(204));",
                  "if (pm.response.code === 204) pm.collectionVariables.unset('token');"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Edición de borradores (manual)",
      "item": [
        {
          "name": "Editar borrador (antes de publicar)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Organization-ID",
                "value": "{{organization_id}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/tenders/{{tender_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Compra trimestral de insumos\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Editar ítem (antes de publicar)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Organization-ID",
                "value": "{{organization_id}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/tenders/{{tender_id}}/items/{{item_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": \"2.500\",\n  \"notes\": \"Entrega por la mañana\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Eliminar ítem (antes de publicar)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Organization-ID",
                "value": "{{organization_id}}"
              }
            ],
            "url": "{{base_url}}/tenders/{{tender_id}}/items/{{item_id}}"
          }
        }
      ]
    }
  ]
}
