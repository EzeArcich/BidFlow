{
  "info": {
    "name": "Bidflow — Fase 3",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Usar comprador y proveedor separados. Ejecutar primero fase 2 para crear/publicar RFQ e invitar. Configurar organization_id, tender_id, invitation_id, item_id y credenciales locales; ningún secreto está versionado. Para varios proveedores repetir su login y oferta antes del cierre. Ejemplo completo en docs/phase-3.md."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080/api/v1"
    },
    {
      "key": "buyer_email",
      "value": ""
    },
    {
      "key": "buyer_password",
      "value": ""
    },
    {
      "key": "supplier_email",
      "value": ""
    },
    {
      "key": "supplier_password",
      "value": ""
    },
    {
      "key": "buyer_token",
      "value": ""
    },
    {
      "key": "supplier_token",
      "value": ""
    },
    {
      "key": "organization_id",
      "value": ""
    },
    {
      "key": "tender_id",
      "value": ""
    },
    {
      "key": "invitation_id",
      "value": ""
    },
    {
      "key": "item_id",
      "value": ""
    },
    {
      "key": "bid_item_id",
      "value": ""
    },
    {
      "key": "request_key",
      "value": ""
    },
    {
      "key": "work_order_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Login comprador",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{buyer_email}}\",\n  \"password\": \"{{buyer_password}}\",\n  \"device_name\": \"postman-phase3\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('buyer_token',pm.response.json().access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Login proveedor",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/portal/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{supplier_email}}\",\n  \"password\": \"{{supplier_password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('supplier_token',pm.response.json().access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Mis invitaciones",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/portal/invitations",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{supplier_token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "4. Detalle propio",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/portal/{{organization_id}}/invitations/{{invitation_id}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{supplier_token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "5. Guardar oferta parcial",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/portal/{{organization_id}}/invitations/{{invitation_id}}/bid",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{supplier_token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"lines\": [\n    {\n      \"tender_item_id\": \"{{item_id}}\",\n      \"quantity\": \"80.000\",\n      \"unit_price\": \"1000.00\",\n      \"delivery_days\": 3\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('bid_item_id',pm.response.json().data.lines[0].id);"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Presentar oferta",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/portal/{{organization_id}}/invitations/{{invitation_id}}/bid/submit",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{supplier_token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "7. Comparar",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Organization-ID",
            "value": "{{organization_id}}"
          }
        ],
        "url": "{{base_url}}/tenders/{{tender_id}}/evaluation",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{buyer_token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "8. Cerrar recepción",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Organization-ID",
            "value": "{{organization_id}}"
          }
        ],
        "url": "{{base_url}}/tenders/{{tender_id}}/close",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{buyer_token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "9. Adjudicar parcialmente",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Organization-ID",
            "value": "{{organization_id}}"
          }
        ],
        "url": "{{base_url}}/tenders/{{tender_id}}/awards",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{buyer_token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"request_key\": \"{{request_key}}\",\n  \"reason\": \"Distribución parcial por capacidad\",\n  \"lines\": [\n    {\n      \"bid_item_id\": \"{{bid_item_id}}\",\n      \"quantity\": \"40.000\",\n      \"unit_price\": \"1000.00\"\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Created or replayed',()=>pm.expect(pm.response.code).to.be.oneOf([200,201]));",
              "pm.collectionVariables.set('work_order_id',pm.response.json().data.orders[0].id);"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('request_key')) pm.collectionVariables.set('request_key',pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        }
      ]
    },
    {
      "name": "10. Historial",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Organization-ID",
            "value": "{{organization_id}}"
          }
        ],
        "url": "{{base_url}}/tenders/{{tender_id}}/awards",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{buyer_token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "11. Órdenes",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Organization-ID",
            "value": "{{organization_id}}"
          }
        ],
        "url": "{{base_url}}/tenders/{{tender_id}}/work-orders",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{buyer_token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "12. Detalle orden",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Organization-ID",
            "value": "{{organization_id}}"
          }
        ],
        "url": "{{base_url}}/work-orders/{{work_order_id}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{buyer_token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "13. Resultado propio proveedor",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/portal/{{organization_id}}/invitations/{{invitation_id}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{supplier_token}}",
              "type": "string"
            }
          ]
        }
      }
    }
  ]
}
